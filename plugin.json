{
	"name": "adb-plugin-moderation",
	"displayName": "Basic Moderation",
	"version": "1.3.1",
	"description": "Core moderation commands: ban, kick, timeout, warn, purge, tickets, and case logging.",
	"author": "DeadIndian",
	"main": "index.js",
	"requiresRestart": true,
	"isolation": false,
	"manifestVersion": 2,
	"process": {
		"model": "persistent",
		"maxExecutionMs": 15000,
		"memoryMb": 256,
		"persistentReason": "Runs un-isolated (system:raw-client) for bulk message purge, channel lock/slowmode, ticket channel creation, and live guild/member lookups \u2014 direct discord.js operations the sandboxed RPC surface cannot express."
	},
	"capabilities": {
		"system": [
			"raw-client"
		],
		"storage": [
			"own-collection",
			"read-profiles",
			"write-profiles"
		],
		"discord": [
			"BanMembers",
			"KickMembers",
			"ModerateMembers",
			"ManageMessages",
			"ManageChannels",
			"SendMessages",
			"ManageRoles",
			"ReadMessageHistory",
			"ViewChannel",
			"EmbedLinks",
			"GuildInfo"
		],
		"hooks": [
			"subscribe"
		]
	},
	"permissions": {
		"system": [
			"raw-client"
		],
		"storage": [
			"own-collection",
			"read-profiles",
			"write-profiles"
		],
		"discord": [
			"BanMembers",
			"KickMembers",
			"ModerateMembers",
			"ManageMessages",
			"ManageChannels",
			"SendMessages",
			"ManageRoles",
			"ReadMessageHistory",
			"ViewChannel",
			"EmbedLinks",
			"GuildInfo"
		],
		"hooks": [
			"subscribe"
		],
		"network": {
			"outbound": []
		},
		"filesystem": {
			"read": [],
			"write": []
		},
		"childProcess": false,
		"nativeAddons": false
	},
	"engines": {
		"core": ">=2.0.0",
		"plugins": {
			"administration": ">=2.0.0"
		}
	},
	"settings": {
		"commandPermissions": true,
		"schema": [
			{
				"key": "log_channel_id",
				"type": "channel",
				"label": "Mod log channel"
			},
			{
				"key": "ticket_category_id",
				"type": "string",
				"label": "Ticket category ID"
			},
			{
				"key": "ticket_support_role_id",
				"type": "role",
				"label": "Ticket support role"
			},
			{
				"key": "ticket_log_channel_id",
				"type": "channel",
				"label": "Ticket log channel"
			},
			{
				"key": "dm_on_action",
				"type": "boolean",
				"label": "DM user on mod action",
				"default": true
			}
		]
	},
	"declaredDependencies": [],
	"discordPermissions": [
		"BanMembers",
		"KickMembers",
		"ModerateMembers",
		"ManageMessages",
		"ManageChannels",
		"ManageRoles",
		"ReadMessageHistory",
		"ViewChannel",
		"SendMessages",
		"EmbedLinks"
	],
	"webUi": {
		"memberPages": [
			{
				"path": "/me/mod-record",
				"label": "My Mod Record",
				"icon": "Shield",
				"source": { "model": "Case", "scope": "member", "sort": { "createdAt": -1 }, "limit": 100 },
				"view": {
					"type": "table",
					"empty": "You have a clean record in this server.",
					"columns": [
						{ "field": "caseNumber", "label": "Case" },
						{ "field": "type", "label": "Type" },
						{ "field": "reason", "label": "Reason" },
						{ "field": "active", "label": "Active" },
						{ "field": "createdAt", "label": "Date" }
					]
				}
			},
			{
				"path": "/me/tickets",
				"label": "My Tickets",
				"icon": "LifeBuoy",
				"source": { "model": "Ticket", "scope": "member", "sort": { "createdAt": -1 }, "limit": 50 },
				"view": {
					"type": "table",
					"empty": "You have no tickets in this server.",
					"columns": [
						{ "field": "reason", "label": "Reason" },
						{ "field": "status", "label": "Status" },
						{ "field": "createdAt", "label": "Opened" },
						{ "field": "closedAt", "label": "Closed" }
					]
				}
			}
		]
	},
	"configSchema": {
		"type": "object",
		"properties": {
			"log_channel_id": {
				"type": "string",
				"default": null
			},
			"ticket_category_id": {
				"type": "string",
				"default": null
			},
			"ticket_support_role_id": {
				"type": "string",
				"default": null
			},
			"ticket_log_channel_id": {
				"type": "string",
				"default": null
			},
			"warn_thresholds": {
				"type": "object",
				"default": {
					"3": {
						"action": "timeout",
						"duration": "1h"
					},
					"5": {
						"action": "timeout",
						"duration": "24h"
					},
					"7": {
						"action": "kick"
					},
					"10": {
						"action": "ban"
					}
				}
			},
			"dm_on_action": {
				"type": "boolean",
				"default": true
			}
		}
	}
}
